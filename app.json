{
  "expo": {
    "name": "Looop",
    "slug": "looop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "looop",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.looop.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Looop listens when you say what you spent."
      }
    },
    "android": {
      "package": "com.looop.app",
      "adaptiveIcon": {
        "backgroundColor": "#2F7CF6",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F9FC",
          "image": "./assets/images/icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Looop uses the camera to read receipts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Looop reads receipts from your photos."
        }
      ],
      "expo-notifications",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
