    "payment.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes an Apple Pay payment. Looop sorts it the next time you open the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkt sich eine Apple-Pay-Zahlung. Looop sortiert sie, wenn du die App das nächste Mal öffnest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda un pago con Apple Pay. Looop lo clasifica la próxima vez que abras la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note un paiement Apple Pay. Looop le classe à la prochaine ouverture de l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva un pagamento Apple Pay. Looop lo ordina alla prossima apertura dell’app."
